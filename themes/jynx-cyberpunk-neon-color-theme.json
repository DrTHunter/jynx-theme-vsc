{
  "$schema": "vscode://schemas/color-theme",
  "name": "Jynx — Cyberpunk Neon",
  "type": "dark",
  "colors": {
    "//": "===== Jynx Neon Cyberpunk palette =====",
    "//ui-pink": "#FF0099  neon magenta accent (kept)",
    "//ui-cyan": "#00F0FF  electric cyan",
    "//ui-bg1": "#08060F  deepest purple-black (chrome)",
    "//ui-bg2": "#0D0B1A  editor background",
    "//ui-bg3": "#161228  elevated / line highlight",
    "//ui-bg4": "#2A2547  borders / selection",
    "//ui-bg5": "#3A3360  lighter slate-purple",
    "//code-white": "#ECECF2  default text",
    "//code-green": "#00E000  neon green strings",
    "//code-yellow": "#FCEE0A  cyberpunk yellow types",
    "//code-purple": "#B14EFF  neon purple numbers",

    "editor.background": "#0D0B1A",
    "editor.foreground": "#ECECF2",
    "editorLineNumber.foreground": "#46406E",
    "editorLineNumber.activeForeground": "#FF0099",
    "editorCursor.foreground": "#FF0099",
    "editor.selectionBackground": "#2A2547",
    "editor.selectionHighlightBackground": "#2A254788",
    "editor.wordHighlightBackground": "#3A336066",
    "editor.wordHighlightStrongBackground": "#3A336099",
    "editor.findMatchBackground": "#FF009966",
    "editor.findMatchHighlightBackground": "#FF009933",
    "editor.lineHighlightBackground": "#161228",
    "editor.lineHighlightBorder": "#00000000",
    "editorIndentGuide.background1": "#1E1A3850",
    "editorIndentGuide.activeBackground1": "#FF009966",
    "editorWhitespace.foreground": "#2A2547",
    "editorBracketMatch.background": "#2A254755",
    "editorBracketMatch.border": "#FF0099",
    "editorBracketHighlight.foreground1": "#FF0099",
    "editorBracketHighlight.foreground2": "#00F0FF",
    "editorBracketHighlight.foreground3": "#00E000",
    "editorBracketHighlight.foreground4": "#FCEE0A",
    "editorBracketHighlight.foreground5": "#FF0099",
    "editorBracketHighlight.foreground6": "#00F0FF",

    "editorGutter.modifiedBackground": "#00F0FF",
    "editorGutter.addedBackground": "#00E000",
    "editorGutter.deletedBackground": "#FF0099",

    "editorError.foreground": "#FF2A6D",
    "editorWarning.foreground": "#FCEE0A",
    "editorInfo.foreground": "#00F0FF",

    "editorWidget.background": "#0A0814",
    "editorWidget.border": "#2A2547",
    "editorSuggestWidget.background": "#0A0814",
    "editorSuggestWidget.border": "#2A2547",
    "editorSuggestWidget.selectedBackground": "#2A2547",
    "editorSuggestWidget.highlightForeground": "#FF0099",
    "editorHoverWidget.background": "#0A0814",
    "editorHoverWidget.border": "#2A2547",

    "editorGroup.border": "#08060F",
    "editorGroupHeader.tabsBackground": "#08060F",
    "editorGroupHeader.noTabsBackground": "#08060F",

    "tab.activeBackground": "#0D0B1A",
    "tab.inactiveBackground": "#08060F",
    "tab.activeForeground": "#ECECF2",
    "tab.inactiveForeground": "#6B6490",
    "tab.activeBorderTop": "#FF0099",
    "tab.activeBorder": "#FF0099",
    "tab.border": "#08060F",
    "tab.hoverBackground": "#161228",
    "tab.unfocusedActiveBorderTop": "#00F0FF",

    "titleBar.activeBackground": "#08060F",
    "titleBar.activeForeground": "#ECECF2",
    "titleBar.inactiveBackground": "#08060F",
    "titleBar.inactiveForeground": "#6B6490",
    "titleBar.border": "#08060F",

    "activityBar.background": "#08060F",
    "activityBar.foreground": "#FF0099",
    "activityBar.inactiveForeground": "#564F7E",
    "activityBar.activeBorder": "#FF0099",
    "activityBar.border": "#08060F",
    "activityBarBadge.background": "#FF0099",
    "activityBarBadge.foreground": "#0D0B1A",

    "sideBar.background": "#08060F",
    "sideBar.foreground": "#C2BEDA",
    "sideBar.border": "#08060F",
    "sideBarTitle.foreground": "#FF0099",
    "sideBarSectionHeader.background": "#0D0B1A",
    "sideBarSectionHeader.foreground": "#ECECF2",
    "sideBarSectionHeader.border": "#2A2547",

    "list.activeSelectionBackground": "#2A2547",
    "list.activeSelectionForeground": "#FFFFFF",
    "list.inactiveSelectionBackground": "#161228",
    "list.hoverBackground": "#161228",
    "list.highlightForeground": "#FF0099",
    "list.focusBackground": "#2A2547",
    "list.errorForeground": "#FF2A6D",
    "list.warningForeground": "#FCEE0A",
    "tree.indentGuidesStroke": "#2A2547",

    "statusBar.background": "#08060F",
    "statusBar.foreground": "#C2BEDA",
    "statusBar.border": "#08060F",
    "statusBar.noFolderBackground": "#08060F",
    "statusBar.debuggingBackground": "#FF0099",
    "statusBar.debuggingForeground": "#0D0B1A",
    "statusBarItem.remoteBackground": "#00F0FF",
    "statusBarItem.remoteForeground": "#0D0B1A",
    "statusBarItem.hoverBackground": "#2A2547",

    "panel.background": "#08060F",
    "panel.border": "#2A2547",
    "panelTitle.activeForeground": "#FF0099",
    "panelTitle.activeBorder": "#FF0099",
    "panelTitle.inactiveForeground": "#6B6490",

    "terminal.background": "#0D0B1A",
    "terminal.foreground": "#ECECF2",
    "terminalCursor.foreground": "#FF0099",
    "terminal.ansiBlack": "#08060F",
    "terminal.ansiRed": "#FF2A6D",
    "terminal.ansiGreen": "#00E000",
    "terminal.ansiYellow": "#FCEE0A",
    "terminal.ansiBlue": "#00B8FF",
    "terminal.ansiMagenta": "#FF0099",
    "terminal.ansiCyan": "#00F0FF",
    "terminal.ansiWhite": "#ECECF2",
    "terminal.ansiBrightBlack": "#564F7E",
    "terminal.ansiBrightRed": "#FF6B9D",
    "terminal.ansiBrightGreen": "#4DF24D",
    "terminal.ansiBrightYellow": "#FFF87A",
    "terminal.ansiBrightBlue": "#6FD9FF",
    "terminal.ansiBrightMagenta": "#FF4DBB",
    "terminal.ansiBrightCyan": "#6FF7FF",
    "terminal.ansiBrightWhite": "#FFFFFF",

    "button.background": "#FF0099",
    "button.foreground": "#0D0B1A",
    "button.hoverBackground": "#FF33AD",
    "button.secondaryBackground": "#2A2547",
    "button.secondaryForeground": "#ECECF2",

    "input.background": "#08060F",
    "input.foreground": "#ECECF2",
    "input.border": "#FF0099",
    "input.placeholderForeground": "#6B6490",
    "inputOption.activeBorder": "#FF0099",
    "inputOption.activeBackground": "#FF009933",
    "inputValidation.errorBackground": "#3A0E22",
    "inputValidation.errorBorder": "#FF2A6D",

    "dropdown.background": "#0A0814",
    "dropdown.foreground": "#ECECF2",
    "dropdown.border": "#2A2547",

    "badge.background": "#FF0099",
    "badge.foreground": "#0D0B1A",

    "progressBar.background": "#FF0099",

    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#2A254788",
    "scrollbarSlider.hoverBackground": "#3A3360AA",
    "scrollbarSlider.activeBackground": "#FF009988",

    "focusBorder": "#FF0099",
    "foreground": "#C2BEDA",
    "selection.background": "#2A2547",
    "widget.shadow": "#00000066",
    "icon.foreground": "#C2BEDA",
    "errorForeground": "#FF2A6D",

    "breadcrumb.foreground": "#6B6490",
    "breadcrumb.focusForeground": "#ECECF2",
    "breadcrumb.activeSelectionForeground": "#FF0099",

    "minimap.findMatchHighlight": "#FF0099",
    "minimapGutter.addedBackground": "#00E000",
    "minimapGutter.modifiedBackground": "#00F0FF",
    "minimapGutter.deletedBackground": "#FF0099",

    "gitDecoration.modifiedResourceForeground": "#00F0FF",
    "gitDecoration.deletedResourceForeground": "#FF2A6D",
    "gitDecoration.untrackedResourceForeground": "#00E000",
    "gitDecoration.ignoredResourceForeground": "#564F7E",
    "gitDecoration.conflictingResourceForeground": "#FCEE0A",

    "peekView.border": "#FF0099",
    "peekViewEditor.background": "#0A0814",
    "peekViewResult.background": "#08060F",
    "peekViewTitle.background": "#0A0814",
    "peekViewResult.selectionBackground": "#2A2547",

    "notificationCenterHeader.background": "#0A0814",
    "notifications.background": "#0A0814",
    "notifications.border": "#2A2547",

    "textLink.foreground": "#00F0FF",
    "textLink.activeForeground": "#6FF7FF",
    "textPreformat.foreground": "#00E000"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a78bfa",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords / storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#d946ef",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Control keywords",
      "scope": [
        "keyword.control",
        "keyword.operator.new",
        "keyword.other.important"
      ],
      "settings": {
        "foreground": "#FF0099",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#00ffff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Classes / types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#c084fc",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#00E000"
      }
    },
    {
      "name": "String interpolation",
      "scope": [
        "string.template",
        "meta.template.expression",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#22d3ee",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "#ff9500"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#a5f3fc"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "variable.other.constant",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#fb7185"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#a855f7"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#fde047"
      }
    },
    {
      "name": "Tags (HTML/JSX)",
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#FF0099",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tag attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#06b6d4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#8b5cf6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#3b82f6"
      }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value.css",
        "meta.property-value.css"
      ],
      "settings": {
        "foreground": "#00E000"
      }
    },
    {
      "name": "Import/Export",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from"
      ],
      "settings": {
        "foreground": "#FF33AD",
        "fontStyle": "bold"
      }
    },
    {
      "name": "This / self",
      "scope": [
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#ff8800",
        "fontStyle": "italic bold"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator"
      ],
      "settings": {
        "foreground": "#fbbf24",
        "fontStyle": "bold"
      }
    },
    {
      "name": "RegExp",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#4DF24D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Escape characters",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#ffff00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#22d3ee",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup headings (text stays pink)",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#FF0099",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup structure punctuation (## | -- > yellow)",
      "scope": [
        "punctuation.definition.heading.markdown",
        "punctuation.definition.table",
        "punctuation.separator.table",
        "punctuation.definition.quote.begin.markdown",
        "punctuation.definition.quote.end.markdown"
      ],
      "settings": {
        "foreground": "#fde047"
      }
    },
    {
      "name": "Markdown table cell text (white, pipes/dashes stay gold)",
      "scope": [
        "markup.table"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#FF0099",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#2dd4bf",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#00E000"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#0ea5e9"
      }
    },
    {
      "name": "Markdown quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#a855f7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Interfaces",
      "scope": [
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#14b8a6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Enums",
      "scope": [
        "entity.name.type.enum"
      ],
      "settings": {
        "foreground": "#f59e0b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#6366f1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Support constants",
      "scope": [
        "support.constant"
      ],
      "settings": {
        "foreground": "#facc15"
      }
    },
    {
      "name": "Meta tags",
      "scope": [
        "meta.tag.metadata",
        "entity.name.tag.metadata"
      ],
      "settings": {
        "foreground": "#00E000"
      }
    },
    {
      "name": "Invalid / deprecated",
      "scope": [
        "invalid",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ff3333",
        "fontStyle": "bold strikethrough"
      }
    },
    {
      "name": "SQL keywords",
      "scope": [
        "keyword.other.DML.sql"
      ],
      "settings": {
        "foreground": "#06b6d4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Python decorators",
      "scope": [
        "entity.name.function.decorator.python",
        "meta.function.decorator.python"
      ],
      "settings": {
        "foreground": "#fbbf24",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Type annotations",
      "scope": [
        "meta.type.annotation",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#38bdf8"
      }
    }
  ]
}
